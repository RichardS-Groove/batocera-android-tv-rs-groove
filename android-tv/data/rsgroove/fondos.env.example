# Android TV RS Groove — configuración de fondos.sh (fondos nuevos para el inicio).
# Copialo a /userdata/android-tv/data/rsgroove/fondos.env (= /data/rsgroove/fondos.env en Android),
# dueño root y permisos 600. NUNCA lo subas a git: puede tener tu clave.

# De dónde bajar: "wallhaven", "unsplash" o "wallhaven unsplash".
FONDOS_FUENTES="wallhaven"

# Cuántos de cada fuente por tanda.
FONDOS_CANTIDAD_WALLHAVEN=24
FONDOS_CANTIDAD_UNSPLASH=6

# Reserva: cuántos fondos se guardan (sirven cuando no hay internet). Entre 0,5 y 4 MB cada uno.
FONDOS_GUARDAR=90

# Cada cuántas horas se suma una tanda nueva cuando la reserva está llena (los más viejos salen).
FONDOS_CADA_HORAS=24

# Wallhaven (sin clave): búsquedas de arte de anime, separadas por |. Solo contenido apto.
WALLHAVEN_BUSQUEDAS="scenery|landscape|cityscape|sunset|cherry blossom|rain|street"

# Unsplash (opcional): https://unsplash.com/oauth/applications -> New Application -> «Access Key».
UNSPLASH_ACCESS_KEY=
FONDOS_BUSQUEDAS="neon city night|cyberpunk|tokyo night"
